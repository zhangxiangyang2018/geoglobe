{
  "version": 8,
  "name": "custom-mvt",
  "sources": {
    "custom": {
      "type": "vector",
      "scheme": "tms",
      "tiles": [
        "http://192.168.31.133:8021/mapserver/layer/多图层服务/tileData/{z}/{y}/{x}.mvt"
      ],
      "minzoom": 0,
      "maxzoom": 18
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#1f2933" }
    },
    {
      "id": "all-fill",
      "type": "fill",
      "source": "custom",
      "source-layer": "polygon",
      "paint": {
        "fill-color": "rgba(74, 144, 217, 0.5)",
        "fill-outline-color": "#a8d8ff"
      }
    },
    {
      "id": "all-line",
      "type": "line",
      "source": "custom",
      "source-layer": "line",
      "paint": {
        "line-color": "#ffd166",
        "line-width": 1.5
      }
    },
    {
      "id": "all-point",
      "type": "circle",
      "source": "custom",
      "source-layer": "point",
      "paint": {
        "circle-color": "#ef476f",
        "circle-radius": 3
      }
    }
  ]
}
